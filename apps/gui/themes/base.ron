// Weave's explicit libadwaita 1.11 baseline.
// Token values from iced-libadwaita/themes/libadwaita.conf (VaZark/iced-libadwaita).
// No identity here: imported skins must declare their own name and key.

// Preserve the reference geometry independently of other design languages.
{
    "tree": {
        "level-offset": 20,
        "row-height": 32,
        "handle-padding": 8,
        "expander-icon-inset": 2,
        "grip-width": 32,
        "drag-threshold": 4,
        "checkbox-size-extra": 2,
        "checkbox-glyph-inset": 4,
        "checkbox-radius": 4,
        "checkbox-border-width": 1.5,
        "connector-width": 1,
        "drop-border-width": 1.5,
        "drop-line-width": 2,
        "drop-line-radius": 1,
        "drag-border-width": 2,
        "drag-scale": 1.01,
        "drag-clip-margin": 24,
        "drag-shadow-offset": 2,
    },
    "tree-row": {
        "separator-width": 1,
        "children-opacity": 0.03,
    },
    "navigation": {
        "indent": 14,
        "initial-sidebar-width": 240,
        "initial-drawer-width": 280,
        "separator-width": 1,
        "selection-opacity": 0.1,
    },
    "navigation.sm": {
        "row-height": 28,
        "row-padding": 8,
        "gap": 1,
        "inset": 4,
    },
    "navigation.md": {
        "row-height": 36,
        "row-padding": 12,
        "gap": 2,
        "inset": 6,
    },
    "navigation.lg": {
        "row-height": 44,
        "row-padding": 14,
        "gap": 2,
        "inset": 6,
    },
    "tabs": {
        "close-icon-size": 12,
        "indicator-height": 2,
        "border-width": 1,
        "separator-width": 1,
        "focus-inset": 4,
        "raise": 2,
    },
    "theme-toggle": {
        "icon-size": 18,
    },
    "toolbar": {
        "shadow-height": 6,
        "shadow-opacity": 0.5,
        "separator-width": 1,
    },
    "colors": {
        "auto-contrast": true,
        "accent": "#3584e4",
        "window-bg": "#fafafb",
        "window-fg": "rgba(0, 0, 6, 0.8)",
        "view-bg": "#ffffff",
        "view-fg": "rgba(0, 0, 6, 0.8)",
        "card-bg": "#ffffff",
        "card-fg": "rgba(0, 0, 6, 0.8)",
        "headerbar-bg": "#ffffff",
        "headerbar-fg": "rgba(0, 0, 6, 0.8)",
        "sidebar-bg": "#ebebed",
        "sidebar-fg": "rgba(0, 0, 6, 0.8)",
        "popover-bg": "#ffffff",
        "popover-fg": "rgba(0, 0, 6, 0.8)",
        "dialog-bg": "#fafafb",
        "dialog-fg": "rgba(0, 0, 6, 0.8)",
        "success": "#2ec27e",
        "warning": "#e5a50a",
        "destructive": "#e01b24",
        "error": "#e01b24",
        "accent-fg": "#ffffff",
        "accent-text": "#0461be",
        "destructive-fg": "#ffffff",
        "destructive-text": "#c30000",
        "success-fg": "#ffffff",
        "success-text": "#007c3d",
        "warning-fg": "rgba(0, 0, 0, 0.8)",
        "warning-text": "#905400",
        "error-fg": "#ffffff",
        "error-text": "#c30000",
        "headerbar-border": "rgba(0, 0, 6, 0.8)",
        "headerbar-shade": "rgba(0, 0, 6, 0.12)",
        "headerbar-darker-shade": "rgba(0, 0, 6, 0.12)",
        "card-shade": "rgba(0, 0, 6, 0.07)",
        "popover-shade": "rgba(0, 0, 6, 0.07)",
        "sidebar-border": "rgba(0, 0, 6, 0.07)",
        "secondary-sidebar-bg": "#f3f3f5",
        "secondary-sidebar-fg": "rgba(0, 0, 6, 0.8)",
        "thumbnail-bg": "#ffffff",
        "thumbnail-fg": "rgba(0, 0, 6, 0.8)",
        "overview-bg": "#f3f3f5",
        "overview-fg": "rgba(0, 0, 6, 0.8)",
        "active-toggle-bg": "#ffffff",
        "active-toggle-fg": "rgba(0, 0, 6, 0.8)",
        "shade": "rgba(0, 0, 6, 0.07)",
        "scrollbar-outline": "#ffffff",
    },
    "dark:colors": {
        "accent": "#3584e4",
        "window-bg": "#222226",
        "window-fg": "#ffffff",
        "view-bg": "#1d1d20",
        "view-fg": "#ffffff",
        "card-bg": "rgba(255, 255, 255, 0.08)",
        "card-fg": "#ffffff",
        "headerbar-bg": "#2e2e32",
        "headerbar-fg": "#ffffff",
        "sidebar-bg": "#2e2e32",
        "sidebar-fg": "#ffffff",
        "popover-bg": "#36363a",
        "popover-fg": "#ffffff",
        "dialog-bg": "#36363a",
        "dialog-fg": "#ffffff",
        "success": "#26a269",
        "warning": "#cd9309",
        "destructive": "#c01c28",
        "error": "#c01c28",
        "accent-text": "#81d0ff",
        "destructive-text": "#ff938c",
        "success-text": "#78e9ab",
        "warning-text": "#ffc252",
        "error-text": "#ff938c",
        "headerbar-border": "#ffffff",
        "headerbar-shade": "rgba(0, 0, 6, 0.36)",
        "headerbar-darker-shade": "rgba(0, 0, 6, 0.9)",
        "card-shade": "rgba(0, 0, 6, 0.36)",
        "popover-shade": "rgba(0, 0, 6, 0.25)",
        "sidebar-border": "rgba(0, 0, 6, 0.36)",
        "secondary-sidebar-bg": "#28282c",
        "secondary-sidebar-fg": "#ffffff",
        "thumbnail-bg": "#39393d",
        "thumbnail-fg": "#ffffff",
        "overview-bg": "#28282c",
        "overview-fg": "#ffffff",
        "active-toggle-bg": "rgba(255, 255, 255, 0.2)",
        "active-toggle-fg": "#ffffff",
        "shade": "rgba(0, 0, 6, 0.25)",
        "scrollbar-outline": "rgba(0, 0, 6, 0.5)",
    },
    "metrics": {
        "space-xs": 4,
        "space-s": 6,
        "space-m": 12,
        "space-l": 18,
        "space-xl": 24,
        "radius-s": 4,
        "radius-m": 9,
        "radius-l": 12,
        "radius-menu": 9,
        "radius-popover": 15,
        "radius-toast": 24,
        "radius-window": 15,
        "button-padding-y": 5,
        "button-padding-x": 10,
        "button-min-height": 34,
        "entry-padding-y": 6,
        "entry-padding-x": 9,
        "entry-min-height": 34,
        "border-width": 1,
        "icon-size": 16,
        "row-padding-y": 6,
        "row-padding-x": 12,
        "row-min-height": 50,
        "row-spacing": 12,
        "card-padding": 12,
        "dialog-padding": 24,
        "popover-padding": 8,
        "page-padding-y": 24,
        "page-padding-x": 12,
        "group-spacing": 24,
        "clamp-maximum": 600,
        "headerbar-height": 47,
        "gutter": 16,
        "band-air": 8,
        "sidebar-width": 240,
        "sidebar-row-height": 36,
        "scrollbar-width": 8,
        "space-xxs": 2,
        "space-xxl": 36,
        "radius-pill": 999,
        "pill-padding-y": 10,
        "pill-padding-x": 32,
        "focus-ring-width": 2,
        "switch-size": 26,
        "checkbox-size": 20,
        "scrollbar-slider-width": 4,
        "scrollbar-margin": 2,
        "progress-height": 8,
        "list-spacing": 0,
        "headerbar-padding-y": 0,
        "headerbar-padding-x": 6,
        "toolbar-spacing": 6,
        "dialog-width": 360,
        "sidebar-padding": 6,
        "sidebar-spacing": 2,
        "sidebar-row-padding": 12,
        "gap": 8,
        "inset": 8,
        "code-padding": 10,
        "inline-padding-x": 3,
        "empty-padding-y": 60,
        "small-button-padding-y": 2,
        "small-button-padding-x": 10,
    },
    "window-decorations": {
        "button-layout": "appmenu:close",
        "button-size": 24,
        "button-radius": 50,
        "titlebar-double-click": "toggle-maximize",
        "titlebar-middle-click": "none",
        "titlebar-right-click": "menu",
        "button-gap": 6,
        "button-icon-size": 16,
    },
    "shadows": {
        "card": "0px 0px 0px 1px rgba(0, 0, 6, 0.03), 0px 1px 3px 1px rgba(0, 0, 6, 0.07), 0px 2px 6px 2px rgba(0, 0, 6, 0.03)",
        "popover": "0px 0px 0px 1px rgba(0, 0, 0, 0.05), 0px 1px 5px 1px rgba(0, 0, 0, 0.09), 0px 2px 14px 3px rgba(0, 0, 0, 0.05)",
        "dialog": "0px 0px 14px 2px rgba(0, 0, 6, 0.03), 0px 0px 5px 2px rgba(0, 0, 6, 0.1), 0px 0px 0px 1px rgba(0, 0, 0, 0.05)",
        "osd": "0px 0px 0px 1px rgba(255, 255, 255, 0.1)",
    },
    "typography": {
        "text-scale": 1,
        "base-size": 14.67,
        "title-1": 1.81,
        "title-2": 1.36,
        "title-3": 1.2,
        "title-4": 1.1,
        "heading": 1,
        "caption-heading": 0.82,
        "caption": 0.82,
        "monospace": 1,
        "small": 0.8861623,
    },
}
